# Local Worker secrets. Copy to worker/.dev.vars (gitignored) for `wrangler dev`,
# or export them in your shell. Never commit real values.

# Clerk secret key for your own Clerk instance (Clerk dashboard → API keys).
# Also used by scripts/qa/clerk-ticket.mjs.
CLERK_SECRET_KEY=

# Public configuration lives in wrangler.jsonc (CLERK_ISSUER, APP_URL).

# Deployment only (Cloudflare dashboard → API tokens). Not needed for local dev.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
